{
  "manifest_version": 3,
  "name": "WhatSave",
  "description": "Free, open-source bulk media downloader for WhatsApp Web by Jstarzz. Download every image, video, audio note and document from one or more chats at once.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png",
    "256": "icons/256.png",
    "512": "icons/512.png"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage/vendor/wppconnect-wa-wrapped.js",
        "inpage/app.js",
        "assets/logo.svg"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
